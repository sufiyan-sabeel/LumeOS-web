{
  "name": "LumeOS",
  "short_name": "LumeOS",
  "description": "LumeOS - a lightweight hybrid web-desktop operating system with a C backend, installable as a PWA.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "productivity",
    "utilities",
    "developer"
  ],
  "icons": [
    {
      "src": "./assets/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./?open=",
      "accept": {
        "text/plain": [
          ".txt",
          ".md"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Files",
      "url": "./?app=files"
    },
    {
      "name": "Terminal",
      "url": "./?app=terminal"
    },
    {
      "name": "Notes",
      "url": "./?app=notes"
    }
  ]
}
